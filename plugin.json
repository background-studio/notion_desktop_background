{
  "schemaVersion": 1,
  "pluginProtocol": 2,
  "id": "notion",
  "displayName": "Notion Background Studio",
  "exeName": "Notion Background Studio.exe",
  "pipeName": "\\\\.\\pipe\\background-studio-notion",
  "capabilities": {
    "mediaKinds": ["image", "video"],
    "managedLaunch": true,
    "autoTakeover": true,
    "hotUpdate": true,
    "blobInject": true,
    "loopbackMediaOnly": true,
    "keepsTargetOnShutdown": true,
    "maxMediaBytes": 67108864,
    "commands": [
      "hello",
      "configure",
      "status",
      "apply",
      "pause",
      "restore",
      "shutdown"
    ]
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit": {
        "type": "string",
        "title": "填充",
        "enum": ["cover", "contain", "fill", "tile"],
        "enumLabels": ["覆盖", "适应", "拉伸", "平铺"],
        "default": "cover"
      },
      "positionX": {
        "type": "number",
        "title": "水平位置",
        "minimum": 0,
        "maximum": 100,
        "step": 1,
        "default": 50
      },
      "positionY": {
        "type": "number",
        "title": "垂直位置",
        "minimum": 0,
        "maximum": 100,
        "step": 1,
        "default": 50
      },
      "opacity": {
        "type": "number",
        "title": "背景图不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.72
      },
      "blur": {
        "type": "number",
        "title": "模糊",
        "minimum": 0,
        "maximum": 40,
        "step": 1,
        "default": 0
      },
      "scale": {
        "type": "number",
        "title": "缩放",
        "minimum": 1,
        "maximum": 1.3,
        "step": 0.01,
        "default": 1
      },
      "overlayColor": {
        "type": "string",
        "title": "底色",
        "format": "color",
        "default": "#101416"
      },
      "overlayOpacity": {
        "type": "number",
        "title": "底色强度",
        "minimum": 0,
        "maximum": 0.9,
        "step": 0.01,
        "default": 0.12
      },
      "blockFillOpacity": {
        "type": "number",
        "title": "色块底色",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.55
      },
      "homeIntensity": {
        "type": "number",
        "title": "页面显示强度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 1
      },
      "taskIntensity": {
        "type": "number",
        "title": "空白页显示强度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.32
      },
      "sidebarOpacity": {
        "type": "number",
        "title": "左侧边栏",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.18
      },
      "surfaceOpacity": {
        "type": "number",
        "title": "顶栏与页面",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.12
      },
      "composerOpacity": {
        "type": "number",
        "title": "浮层/输入区",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.88
      },
      "menuOpacity": {
        "type": "number",
        "title": "弹出菜单",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.9
      },
      "terminalOpacity": {
        "type": "number",
        "title": "终端层",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.9
      },
      "enabledOnHome": {
        "type": "boolean",
        "title": "页面显示背景",
        "default": true
      },
      "enabledOnTasks": {
        "type": "boolean",
        "title": "空白页显示背景",
        "default": true
      },
      "videoMuted": {
        "type": "boolean",
        "title": "静音播放",
        "default": true
      },
      "videoPlaybackRate": {
        "type": "number",
        "title": "播放速度",
        "minimum": 0.25,
        "maximum": 2,
        "step": 0.25,
        "default": 1
      }
    }
  }
}
